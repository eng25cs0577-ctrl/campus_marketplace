# Neon connection string (Neon dashboard → Connect). Keep ?sslmode=require at the end.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Port the API listens on (Render sets this automatically)
PORT=3000
# Where the frontend is hosted — only this origin may call the API from a browser
FRONTEND_URL=https://YOUR-GITHUB-USERNAME.github.io
